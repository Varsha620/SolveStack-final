ENVIRONMENT=development

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

DATABASE_URL=sqlite:///./solvestack_dev.db

# Comma-separated frontend URLs allowed to call the API.
# Production example:
# FRONTEND_ORIGINS=https://your-solvestack-frontend.vercel.app
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=false

# Optional scraper credentials.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
STACKEXCHANGE_KEY=
GITHUB_TOKEN=
