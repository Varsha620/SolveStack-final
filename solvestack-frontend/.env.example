VITE_API_URL=http://localhost:8000

# Optional. Leave empty unless your WebSocket server is hosted separately.
# If omitted, the app derives this from VITE_API_URL:
# http -> ws, https -> wss
VITE_WS_URL=

# fallback shows curated demo data when the live backend/scrapers return empty results.
# Set to false when you want a strict live-data-only frontend.
VITE_DEMO_MODE=fallback
